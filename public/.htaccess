# ÜRETİLDİ: scripts/derleme-sonrasi.mjs (elle düzenlemeyin). Kaynak: src/data/yonlendirmeler.json.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .json .webmanifest .css .js .svg
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.befaproses.com%{REQUEST_URI} [R=301,L]
